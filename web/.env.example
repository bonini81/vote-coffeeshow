# Claves PÚBLICAS de Firebase (consola > Configuración del proyecto > Tus apps).
# Sin estos valores, en desarrollo se usa el proyecto de emulador demo-coffeeshow.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Clave pública (site key) de Cloudflare Turnstile — fase 5.
VITE_TURNSTILE_SITE_KEY=

# En desarrollo se conecta a los emuladores salvo que se ponga "false".
VITE_USE_EMULATORS=true

# Clave de sitio de Fraud Defense (reCAPTCHA Enterprise) para App Check.
VITE_APPCHECK_SITE_KEY=
