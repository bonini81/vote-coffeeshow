rules_version = '2';

// Reglas de negocio (ver CLAUDE.md):
// - El cliente NUNCA escribe: todo voto pasa por la callable function submitVote (Admin SDK).
// - `cafeterias` es público (fichas de las cafeterías) y NO contiene contadores.
// - El contador de votos vive en `conteos/{cafeteriaId}` y solo lo leen los admins.
// - Solo los admins (custom claim admin == true) leen votos.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /cafeterias/{cafeteriaId} {
      allow read: if true;
      allow write: if false;
    }

    match /conteos/{cafeteriaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /votos/{votoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /votosPorEmail/{id} {
      allow read, write: if false;
    }

    match /votosPorCedula/{id} {
      allow read, write: if false;
    }

    match /rateLimit/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
