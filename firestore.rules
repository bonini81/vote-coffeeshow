rules_version = '2';

// Reglas de negocio (ver CLAUDE.md):
// - El cliente NUNCA escribe: todo voto pasa por la callable function submitVote (Admin SDK).
// - Solo los admins (custom claim admin == true) leen votos.
// - TODO (fase 3): decidir cómo ocultar el contador `votos` de `cafeterias` al público
//   (p. ej. moverlo a `conteos/{id}` solo-admin).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /cafeterias/{cafeteriaId} {
      allow read: if true;
      allow write: if false;
    }

    match /votos/{votoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /votosPorEmail/{id} {
      allow read, write: if false;
    }

    match /votosPorCedula/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
