# Copiar a functions/.secret.local (ignorado por git) para usar los emuladores.
# Solo valores de desarrollo: en producción viven en Secret Manager.
PEPPER=pepper-solo-para-desarrollo
# Secret de prueba de Cloudflare: siempre aprueba. Para forzar un fallo usar 2x0000000000000000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
